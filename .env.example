# Hersciety — environment variables
# Copy to .env.local and fill in. NEVER commit real values.

# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only. Bypasses RLS for reads it is allowed to make;
# sensitive writes are still blocked at the database (REVOKEd) and flow through
# SECURITY DEFINER functions.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side pepper for hashing device fingerprints and banned identifiers.
# Generate once (e.g. `openssl rand -hex 32`) and never rotate casually —
# rotating it orphans existing ban-evasion hashes.
IDENTIFIER_HASH_PEPPER=

# Cloudflare Turnstile SITE key (public — it ships in the client bundle).
# Powers the bot check on signup and login. Optional: without it the
# widget simply does not render and the forms work untouched. The
# matching SECRET lives only in Supabase auth config (captcha settings),
# never in this app's environment.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Search-engine visibility switch (optional; default OFF = noindex).
# Leave UNSET to ship "dark": reachable by a direct link but not
# search-discoverable (no-index header + disallow-all robots.txt + noindex meta).
# Set to exactly `true` ONLY once moderation tooling exists, then redeploy, to
# allow indexing. See src/lib/seo.ts and PROGRESS.md "How to go public".
# SITE_INDEXABLE=true

# ---------------------------------------------------------------------------
# Provisioning (one-time) — used ONLY by `npm run provision`.
# Export these in your shell for the one run; do NOT persist them in .env.local.
# `provision.sh` fills in the three Supabase values above for you. Full guide
# with where-to-find-it notes: docs/provisioning.md
# ---------------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=     # PAT: dashboard → Account → Access Tokens
# SUPABASE_DB_PASSWORD=      # strong Postgres password you choose (>=12 chars)
# SUPABASE_ORG_SLUG=         # optional; auto-detected if you have one org
# SUPABASE_PROJECT_REF=      # PREFERRED: the live project's 20-char ref from
                             # the dashboard URL (currently hiphjzhlwiztqgezzipf).
                             # When set, the name below is not consulted at all.
# SUPABASE_PROJECT_NAME=     # optional; default "Hersciety" — must match the
                             # hosted project's exact current name when no ref
                             # is given. Prefer the ref: names can drift.
# SUPABASE_ALLOW_CREATE=     # set to exactly `yes` ONLY for a first-time
                             # provision. Without it the script refuses to
                             # create a new project when nothing matches,
                             # instead of silently spawning a duplicate.
# SUPABASE_REGION=           # optional; default us-east-1
# SUPABASE_INSTANCE_SIZE=    # optional; default micro (needs a Pro org)
# SITE_URL=                  # optional; default https://hersciety.com (canonical)
# WEBAUTHN_RP_ID=            # optional; default hersciety.com — permanent once
                             # members hold passkeys (changing it then would
                             # invalidate every one of them)
# OWNER_EMAIL=               # Owner login email
# OWNER_PASSWORD=            # Owner initial password (add MFA right after)
# OWNER_HANDLE=              # Owner public @handle
# OWNER_LEGAL_NAME=          # Owner verified legal name (stored privately)
# OWNER_DOB=                 # Owner date of birth, YYYY-MM-DD (18+)
# OWNER_PHONE=               # optional; E.164, e.g. +1...
# Custom SMTP (Resend) — strongly recommended so confirmation emails actually send:
# SMTP_HOST=                 # e.g. smtp.resend.com
# SMTP_PORT=                 # e.g. 465
# SMTP_USER=                 # e.g. resend
# SMTP_PASS=                 # your Resend API key
# SMTP_ADMIN_EMAIL=          # e.g. no-reply@unitedfeminist.com (the company
                             # domain owns all email; hersciety.com has no DKIM)
# SMTP_SENDER_NAME=          # e.g. Hersciety
