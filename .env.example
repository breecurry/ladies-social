# United Feminist — environment variables
# Copy to .env.local and fill in. NEVER commit real values.

# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only. Bypasses RLS for reads it is allowed to make;
# sensitive writes are still blocked at the database (REVOKEd) and flow through
# SECURITY DEFINER functions.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Lookup (phone line-type triage signal). Optional: when unset, the
# phone signal is recorded as "unknown" and never flags anyone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Shared secret for the internal job-drain endpoint (pg_cron / external cron).
INTERNAL_CRON_SECRET=

# Server-side pepper for hashing device fingerprints and banned identifiers.
# Generate once (e.g. `openssl rand -hex 32`) and never rotate casually —
# rotating it orphans existing ban-evasion hashes.
IDENTIFIER_HASH_PEPPER=

# ---------------------------------------------------------------------------
# Provisioning (one-time) — used ONLY by `npm run provision`.
# Export these in your shell for the one run; do NOT persist them in .env.local.
# `provision.sh` fills in the three Supabase values above for you. Full guide
# with where-to-find-it notes: docs/provisioning.md
# ---------------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=     # PAT: dashboard → Account → Access Tokens
# SUPABASE_DB_PASSWORD=      # strong Postgres password you choose (>=12 chars)
# SUPABASE_ORG_SLUG=         # optional; auto-detected if you have one org
# SUPABASE_PROJECT_NAME=     # optional; default "United Feminist"
# SUPABASE_REGION=           # optional; default us-east-1
# SUPABASE_INSTANCE_SIZE=    # optional; default micro (needs a Pro org)
# SITE_URL=                  # optional; default https://unitedfeminist.com
# WEBAUTHN_RP_ID=            # optional; default unitedfeminist.com (permanent)
# OWNER_EMAIL=               # Owner login email
# OWNER_PASSWORD=            # Owner initial password (add MFA right after)
# OWNER_HANDLE=              # Owner public @handle
# OWNER_LEGAL_NAME=          # Owner verified legal name (stored privately)
# OWNER_DOB=                 # Owner date of birth, YYYY-MM-DD (18+)
# OWNER_PHONE=               # optional; E.164, e.g. +1...
# Custom SMTP (Resend) — strongly recommended so confirmation emails actually send:
# SMTP_HOST=                 # e.g. smtp.resend.com
# SMTP_PORT=                 # e.g. 465
# SMTP_USER=                 # e.g. resend
# SMTP_PASS=                 # your Resend API key
# SMTP_ADMIN_EMAIL=          # e.g. no-reply@unitedfeminist.com
# SMTP_SENDER_NAME=          # e.g. United Feminist
